<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Dawn Player</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>dawnplayer</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Allow audio to keep playing when the app is backgrounded, gated by
	     the in-app "Continue audio in background" setting (Task 2.3). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Files on this device. Videos open IN PLACE (no copy of a film the size
	     of the disk), which is what LSSupportsOpeningDocumentsInPlace allows;
	     LocalMediaBridge in AppDelegate.swift keeps a bookmark so the file can be
	     resumed after a restart. "Alternate": we never claim to be the default
	     app for these types. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.mpeg-4</string>
				<string>com.apple.quicktime-movie</string>
				<string>com.apple.m4v-video</string>
				<string>public.avi</string>
				<string>public.mpeg</string>
				<string>public.mpeg-2-video</string>
				<string>public.mpeg-2-transport-stream</string>
				<string>public.avchd-mpeg-2-transport-stream</string>
				<string>org.matroska.mkv</string>
				<string>org.webmproject.webm</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Playlist</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.m3u-playlist</string>
			</array>
		</dict>
	</array>
	<!-- Containers iOS does not declare itself. Imported, not exported: we do
	     not own these formats, we only open them. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.matroska.mkv</string>
			<key>UTTypeDescription</key>
			<string>Matroska video</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.movie</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mkv</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>video/x-matroska</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.webmproject.webm</string>
			<key>UTTypeDescription</key>
			<string>WebM video</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.movie</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>webm</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>video/webm</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- UIFileSharingEnabled is deliberately NOT set: it would publish the
	     app's Documents folder in Files and Finder, and that is where drift
	     keeps the database. -->

	<!-- Export compliance: Dawn Player adds no encryption of its own; it
	     only uses HTTPS/TLS from the OS. Declaring this here answers the
	     export-compliance question once, instead of on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Camera: only to scan the pairing QR a television shows (Settings ->
	     Set up a TV). Never on without that screen open. -->
	<key>NSCameraUsageDescription</key>
	<string>Scans the pairing code shown on your TV.</string>

	<!-- Chromecast: finding Cast devices is a local-network (Bonjour) search,
	     which iOS 14+ only allows for the services listed here, and only after
	     the user agrees. The prompt appears when the cast list is first opened,
	     not at launch. _CC1AD845 is the Default Media Receiver's app id. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Finds Chromecasts and TVs on your network so you can play on them.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
		<string>_CC1AD845._googlecast._tcp</string>
	</array>

	<!-- App Transport Security, narrowed from NSAllowsArbitraryLoads.
	     ATS governs Apple's URL loading system only. Playback does not use it:
	     libmpv/FFmpeg opens its own connections, and so does Dart's HttpClient
	     (playlists, server API, artwork). What does go through Apple's stack is
	     AirPlay (AVPlayer), which ArbitraryLoadsForMedia covers for http://
	     media, and anything on the local network, which LocalNetworking
	     covers. Explained to App Review in store/apple/review_notes.txt. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
</dict>
</plist>
