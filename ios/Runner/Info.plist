<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Dawn Player</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>dawnplayer</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Allow audio to keep playing when the app is backgrounded, gated by
	     the in-app "Continue audio in background" setting (Task 2.3). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- App Transport Security: most IPTV panels serve plain HTTP, which iOS
	     blocks by default. Without this the stream fails silently. -->
	<!-- Export compliance: Dawn Player adds no encryption of its own; it
	     only uses HTTPS/TLS from the OS. Declaring this here answers the
	     export-compliance question once, instead of on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Camera: only to scan the pairing QR a television shows (Settings ->
	     Set up a TV). Never on without that screen open. -->
	<key>NSCameraUsageDescription</key>
	<string>Scans the pairing code shown on your TV.</string>

	<!-- Chromecast: finding Cast devices is a local-network (Bonjour) search,
	     which iOS 14+ only allows for the services listed here, and only after
	     the user agrees. The prompt appears when the cast list is first opened,
	     not at launch. _CC1AD845 is the Default Media Receiver's app id. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Finds Chromecasts and TVs on your network so you can play on them.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
		<string>_CC1AD845._googlecast._tcp</string>
	</array>

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
